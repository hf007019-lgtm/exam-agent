# Application
APP_NAME=Exam Agent
DATABASE_URL=sqlite:///./data/exam_agent.db
API_RESULT_LIMIT=100
OBSERVABILITY_TEXT_LIMIT=2000

# Local authentication
AUTH_ENABLED=false
DEV_LOGIN_ENABLED=true
DEFAULT_DEV_USERNAME=anonymous_dev
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Optional OpenAI-compatible LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=

# Optional external policy retrieval service
RAG_ENABLED=false
RAG_BASE_URL=http://127.0.0.1:18000
RAG_ASK_PATH=/api/v1/search/ask
RAG_TIMEOUT_SECONDS=20
RAG_TOP_K=5

# Optional local analysis-skill directory
GONGKAO_SELECTION_SKILL_DIR=
